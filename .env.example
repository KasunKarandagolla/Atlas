# ATLAS environment variable NAMES ONLY. Never commit real values.
# Copy to .env (gitignored) for local use only.

# Runtime identity (no secrets)
ATLAS_ENVIRONMENT=
ATLAS_EXPECTED_VENUE=
ATLAS_EXPECTED_PRODUCT=
ATLAS_ACCOUNT_IDENTITY_HASH=

# Bybit connectivity (template names only; all authenticated capabilities remain UNVERIFIED)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_TESTNET_BASE_URL=

# Local paths
ATLAS_JOURNAL_PATH=
ATLAS_WRITER_LOCK_PATH=

# Ops / notifications (not configured in the stabilized V1 baseline)
ATLAS_OPS_STATUS_PATH=

# Future integrations only; this template is inert and is not loaded by Atlas.
# Populate only after separate owner approval, using a protected local secret store.
DEEPSEEK_API_KEY=REPLACE_LOCALLY_AFTER_APPROVAL
ATLAS_BINANCE_DEMO_API_KEY=REPLACE_LOCALLY_AFTER_APPROVAL
ATLAS_BINANCE_DEMO_API_SECRET=REPLACE_LOCALLY_AFTER_APPROVAL
