# ATLAS environment variable NAMES ONLY. Never commit real values.
# Copy to .env (gitignored) for local use only.

# Runtime identity (no secrets)
ATLAS_ENVIRONMENT=
ATLAS_EXPECTED_VENUE=
ATLAS_EXPECTED_PRODUCT=
ATLAS_ACCOUNT_IDENTITY_HASH=

# Bybit connectivity (template names only; all authenticated capabilities remain UNVERIFIED)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_TESTNET_BASE_URL=

# Local paths
ATLAS_JOURNAL_PATH=
ATLAS_WRITER_LOCK_PATH=

# Ops / notifications (not configured in the stabilized V1 baseline)
ATLAS_OPS_STATUS_PATH=

# R4 provider test. This template is inert and is not loaded by Atlas.
# Supply the key only from the trusted runner's secret manager. No provider call
# is permitted until the owner's free-tier/no-billing authorization is verified.
GEMMA_MODEL=gemma-4-31b-it
GEMINI_API_KEY=
# Set true only in a trusted runner after recording owner verification.
ATLAS_GEMINI_FREE_TIER_VERIFIED=false

# R4 Futures Demo runner. Keep account state under its separate DEMO_ONLY root.
# The adapter hardcodes both official Demo endpoints; endpoint overrides are not supported.
# Populate these names only with credentials created in Binance Futures Demo.
ATLAS_BINANCE_FUTURES_ENV=DEMO_ONLY
BINANCE_FUTURES_DEMO_API_KEY=
BINANCE_FUTURES_DEMO_API_SECRET=
ATLAS_BINANCE_FUTURES_DATA_ROOT=

# Production provider preference is unchanged. No DeepSeek calls are made in R4.
DEEPSEEK_API_KEY=
